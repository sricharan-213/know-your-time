def is_valid_date(day, month, year):
    # Checking if month is valid (between 1 and 12)
    if month < 1 or month > 12:
        return False
    
    # Days in each month (for regular years)
    days_in_month = {
        1: 31, 2: 28, 3: 31, 4: 30, 5: 31, 6: 30, 
        7: 31, 8: 31, 9: 30, 10: 31, 11: 30, 12: 31
    }
    
    # Checking if the year is a leap year to adjust February days
    if leap(year):
        days_in_month[2] = 29  # February has 29 days in a leap year
    
    # Check if the day is within the valid range for the given month
    if day < 1 or day > days_in_month[month]:
        return False
    
    return True

# Function to check if a year is a leap year
def leap(y):
    x = y % 4
    y = y % 400
    z = y % 100
    if ((x == 0 and z != 0) or (y == 0)):
        return True
    return False

